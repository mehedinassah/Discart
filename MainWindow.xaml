<Window x:Class="DiskAuditPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Discart" Height="760" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#F3F3F3">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="6"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="15">
            <StackPanel>
                <TextBlock x:Name="DriveInfoText" FontSize="18" FontWeight="Bold" Foreground="#333"/>
                <ProgressBar x:Name="DriveProgressBar" Height="12" Margin="0,8,0,8" Foreground="#0078D7" Background="#E0E0E0" BorderThickness="0"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Status text -->
                        <ColumnDefinition Width="Auto"/> <!-- Banner -->
                        <ColumnDefinition Width="Auto"/> <!-- Help Button -->
                        <ColumnDefinition Width="*"/>    <!-- Empty space to push everything left -->
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock x:Name="ScanStatusText" FontSize="12" Foreground="Gray" Text="Ready to scan."/>
                    
                    <!-- Admin/Standard Banner -->
                    <Border x:Name="ModeBanner" Grid.Column="1" Background="#FFD700" CornerRadius="3" Padding="8,2" Margin="15,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ModeText" Text="⚠️ Running as Standard User" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="#333"/>
                            <Button x:Name="AdminBtn" Content="Restart as Admin" Margin="10,0,0,0" Padding="5,1" Background="Transparent" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="AdminBtn_Click" Visibility="Collapsed" Foreground="#005A9E"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Help Button (Now sits right next to the banner) -->
                    <Button x:Name="HelpBtn" Grid.Column="2" Content="❓" Width="20" Height="20" Margin="5,0,0,0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="HelpBtn_Click" ToolTip="What does this mean?"/>
                </Grid>            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="White" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0" Height="25" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="Search by folder name..."/>
                <Button x:Name="ToggleAllBtn" Grid.Column="1" Content="☑ Toggle All" Margin="10,0,0,0" Padding="5,0" Click="ToggleAllBtn_Click"/>
                <Button x:Name="ExportBtn" Grid.Column="3" Content="📄 Export Report" Padding="5,0" Click="ExportBtn_Click" ToolTip="Save a text file report of your disk to the Desktop."/>
            </Grid>
        </Border>

        <!-- Main List -->
        <ScrollViewer Grid.Row="2" Margin="10,0,10,0" Background="White" BorderThickness="1" BorderBrush="#CCCCCC" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ResultsPanel" Margin="5"/>
        </ScrollViewer>

        <!-- Details Panel -->
        <Border Grid.Row="3" Margin="10,5,10,5" Background="#FAFAFA" BorderThickness="1" BorderBrush="#E0E0E0" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="DetailsText" FontSize="13" Foreground="#333" TextWrapping="Wrap" Text="Select an item to see details. Expand a folder to see what's inside."/>
                </ScrollViewer>
                <Button x:Name="CopyPathBtn" Grid.Column="1" Content="📋 Copy Path" Margin="10,0,0,0" Padding="10,5" VerticalAlignment="Top" Visibility="Collapsed" Click="CopyPathBtn_Click" ToolTip="Copy the full path to your clipboard"/>
            </Grid>
        </Border>

        <!-- Bottom Buttons -->
        <Border Grid.Row="4" Background="White" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="ScanButton" Content="Scan Again" Width="100" Height="35" Margin="0,0,10,0" Click="ScanButton_Click"/>
                <Button x:Name="EmptyBinBtn" Grid.Column="1" Content="🗑 Empty Recycle Bin" Width="150" Height="35" Margin="0,0,20,0" Click="EmptyBinBtn_Click"/>
                
                <TextBlock x:Name="SelectionText" Grid.Column="2" VerticalAlignment="Center" FontSize="14" Foreground="Gray" Text="Nothing selected"/>
                
                <Button x:Name="SweepBtn" Grid.Column="3" Content="🧹 Sweep Safe Items" Width="150" Height="35" Margin="0,0,10,0" Background="#0078D7" Foreground="White" FontWeight="Bold" Click="SweepBtn_Click"/>
                <Button x:Name="DeleteButton" Grid.Column="4" Content="Delete Selected" Width="150" Height="35" Background="#228B22" Foreground="White" FontWeight="Bold" Click="DeleteButton_Click"/>
            </Grid>
        </Border>
        
        <!-- Loading Bar -->
        <ProgressBar x:Name="LoadingBar" Grid.Row="5" IsIndeterminate="True" Visibility="Collapsed" Foreground="#0078D7" Background="#E0E0E0" BorderThickness="0"/>
    </Grid>
</Window>