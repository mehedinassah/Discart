<Window x:Class="DiskAuditPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DiskAudit Pro" Height="720" Width="960"
        WindowStartupLocation="CenterScreen" Background="#F3F3F3">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="15">
            <StackPanel>
                <TextBlock x:Name="DriveInfoText" FontSize="18" FontWeight="Bold" Foreground="#333"/>
                
                <!-- Drive Storage Bar -->
                <ProgressBar x:Name="DriveProgressBar" Height="12" Margin="0,8,0,8" Foreground="#0078D7" Background="#E0E0E0" BorderThickness="0"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock x:Name="ScanStatusText" FontSize="12" Foreground="Gray" Text="Ready to scan."/>
                    
                    <!-- Loading Animation -->
                    <ProgressBar x:Name="LoadingBar" Grid.Column="1" Width="150" Height="12" IsIndeterminate="True" Visibility="Collapsed" Foreground="#228B22" Background="#E0E0E0" BorderThickness="0"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Main Tree View -->
        <TreeView x:Name="ResultsTree" Grid.Row="1" Margin="10" Background="White" BorderThickness="1" BorderBrush="#CCCCCC">
            <TreeView.Resources>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True"/>
                </Style>
            </TreeView.Resources>
        </TreeView>

        <!-- Bottom Buttons -->
        <Border Grid.Row="2" Background="White" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="ScanButton" Content="Scan Again" Width="100" Height="35" Margin="0,0,10,0" Click="ScanButton_Click"/>
                <TextBlock x:Name="SelectionText" Grid.Column="1" VerticalAlignment="Center" FontSize="14" Foreground="Gray" Text="Nothing selected"/>
                <Button x:Name="DeleteButton" Grid.Column="2" Content="Delete Selected to Recycle Bin" Width="220" Height="35" Background="#228B22" Foreground="White" FontWeight="Bold" Click="DeleteButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>