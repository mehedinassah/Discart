<Window x:Class="DiskAuditPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Discart" Height="720" Width="960"
        WindowStartupLocation="CenterScreen" Background="#F3F3F3">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="6"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0" Background="White" Padding="15">
            <StackPanel>
                <TextBlock x:Name="DriveInfoText" FontSize="18" FontWeight="Bold" Foreground="#333"/>
                <ProgressBar x:Name="DriveProgressBar" Height="12" Margin="0,8,0,8" Foreground="#0078D7" Background="#E0E0E0" BorderThickness="0"/>
                <TextBlock x:Name="ScanStatusText" FontSize="12" Foreground="Gray" Text="Ready to scan."/>
            </StackPanel>
        </Border>

        <!-- Replaced TreeView with ScrollViewer for total UI control -->
        <ScrollViewer Grid.Row="1" Margin="10" Background="White" BorderThickness="1" BorderBrush="#CCCCCC" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ResultsPanel" Margin="5"/>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="10,0,10,5" Background="#FAFAFA" BorderThickness="1" BorderBrush="#E0E0E0" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="DetailsText" FontSize="13" Foreground="#333" TextWrapping="Wrap" Text="Select an item to see details. Expand a folder to see what's inside."/>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="3" Background="White" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ScanButton" Content="Scan Again" Width="100" Height="35" Margin="0,0,10,0" Click="ScanButton_Click"/>
                <TextBlock x:Name="SelectionText" Grid.Column="1" VerticalAlignment="Center" FontSize="14" Foreground="Gray" Text="Nothing selected"/>
                <Button x:Name="DeleteButton" Grid.Column="2" Content="Delete Selected to Recycle Bin" Width="220" Height="35" Background="#228B22" Foreground="White" FontWeight="Bold" Click="DeleteButton_Click"/>
            </Grid>
        </Border>
        <ProgressBar x:Name="LoadingBar" Grid.Row="4" IsIndeterminate="True" Visibility="Collapsed" Foreground="#0078D7" Background="#E0E0E0" BorderThickness="0"/>
    </Grid>
</Window>